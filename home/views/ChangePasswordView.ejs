<%- include('partials/app-shell-start') %>

<section class="max-w-md mx-auto">
  <h1 class="text-2xl font-semibold mb-2">Change password</h1>
  <p class="opacity-70 text-sm mb-6">Update your password. Other signed-in devices will be logged out.</p>

  <form
    id="change-password-form"
    class="flex flex-col gap-3 bg-base-100 p-6 rounded-box shadow-sm"
    data-endpoint="<%= changePasswordEndpoint %>"
    data-password-min="<%= passwordMinLength %>"
    data-password-max="<%= passwordMaxLength %>"
    novalidate
  >
    <div id="change-password-error" class="alert alert-error text-sm hidden" role="alert"></div>
    <div id="change-password-success" class="alert alert-success text-sm hidden" role="status"></div>

    <label class="form-control w-full">
      <span class="label-text">Current password</span>
      <input
        type="password"
        name="currentPassword"
        class="input input-bordered w-full"
        autocomplete="current-password"
        required
        minlength="<%= passwordMinLength %>"
        maxlength="<%= passwordMaxLength %>"
      >
    </label>

    <label class="form-control w-full">
      <span class="label-text">New password</span>
      <input
        type="password"
        name="newPassword"
        class="input input-bordered w-full"
        autocomplete="new-password"
        required
        minlength="<%= passwordMinLength %>"
        maxlength="<%= passwordMaxLength %>"
      >
    </label>

    <label class="form-control w-full">
      <span class="label-text">Confirm new password</span>
      <input
        type="password"
        name="confirmPassword"
        class="input input-bordered w-full"
        autocomplete="new-password"
        required
        minlength="<%= passwordMinLength %>"
        maxlength="<%= passwordMaxLength %>"
      >
    </label>

    <p class="text-xs opacity-70">
      Password <%= passwordMinLength %>–<%= passwordMaxLength %> chars.
    </p>

    <button type="submit" class="btn btn-primary w-full">Change password</button>
  </form>
</section>

<script src="/js/change-password.js" defer></script>

<%- include('partials/app-shell-end') %>
