<%- include('partials/app-shell-start') %>

<section class="max-w-md">
  <header class="md-page-header">
    <h1 class="md-page-title">Change password</h1>
    <p class="md-page-desc">Update your password. Other signed-in devices will be logged out.</p>
  </header>

  <form
    id="change-password-form"
    class="flex flex-col gap-3 md-surface p-5"
    data-endpoint="<%= changePasswordEndpoint %>"
    data-password-min="<%= passwordMinLength %>"
    data-password-max="<%= passwordMaxLength %>"
    novalidate
  >
    <div id="change-password-error" class="alert alert-error text-sm hidden" role="alert"></div>
    <div id="change-password-success" class="alert alert-success text-sm hidden" role="status"></div>

    <label class="form-control w-full">
      <span class="label-text font-medium">Current password</span>
      <input
        type="password"
        name="currentPassword"
        class="input input-bordered w-full"
        autocomplete="current-password"
        required
        minlength="<%= passwordMinLength %>"
        maxlength="<%= passwordMaxLength %>"
      >
    </label>

    <label class="form-control w-full">
      <span class="label-text font-medium">New password</span>
      <input
        type="password"
        name="newPassword"
        class="input input-bordered w-full"
        autocomplete="new-password"
        required
        minlength="<%= passwordMinLength %>"
        maxlength="<%= passwordMaxLength %>"
      >
    </label>

    <label class="form-control w-full">
      <span class="label-text font-medium">Confirm new password</span>
      <input
        type="password"
        name="confirmPassword"
        class="input input-bordered w-full"
        autocomplete="new-password"
        required
        minlength="<%= passwordMinLength %>"
        maxlength="<%= passwordMaxLength %>"
      >
    </label>

    <p class="text-xs text-base-content/60">
      Password <%= passwordMinLength %>–<%= passwordMaxLength %> chars.
    </p>

    <button type="submit" class="btn btn-primary w-full gap-2">
      <%- include('partials/icon', { name: 'key', size: 'sm' }) %>
      Change password
    </button>
  </form>
</section>

<%- include('partials/app-shell-end', { pageScript: '/js/change-password.js' }) %>
