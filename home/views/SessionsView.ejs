<%- include('partials/app-shell-start') %>

<section
  id="sessions-page"
  data-sessions-endpoint="<%= sessionsEndpoint %>"
  data-logout-template="<%= sessionsLogoutTemplate %>"
  data-logout-others-endpoint="<%= sessionsLogoutOthersEndpoint %>"
  data-page-limit="<%= sessionsPageLimit %>"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold mb-2">Sessions</h1>
      <p class="opacity-70 text-sm">Manage devices signed in to your account.</p>
    </div>
    <button type="button" id="logout-others-button" class="btn btn-outline btn-sm">
      Đăng xuất tất cả máy khác
    </button>
  </div>

  <div id="sessions-error" class="alert alert-error text-sm hidden mb-4" role="alert"></div>
  <p id="sessions-status" class="text-sm opacity-70 mb-4">Loading sessions…</p>

  <div id="sessions-results" class="mb-6">
    <div id="sessions-table-wrap" class="hidden md:block overflow-x-auto bg-base-100 rounded-box shadow-sm">
      <table class="table">
        <thead>
          <tr>
            <th>Device</th>
            <th>IP</th>
            <th>Created</th>
            <th>Last seen</th>
            <th class="w-28">Action</th>
          </tr>
        </thead>
        <tbody id="sessions-table-body"></tbody>
      </table>
    </div>
    <ul id="sessions-list" class="md:hidden flex flex-col gap-3"></ul>
  </div>

  <div class="flex items-center justify-between gap-3">
    <button type="button" id="sessions-prev" class="btn btn-outline btn-sm" disabled>Previous</button>
    <span id="sessions-page-info" class="text-sm opacity-70"></span>
    <button type="button" id="sessions-next" class="btn btn-outline btn-sm" disabled>Next</button>
  </div>
</section>

<%- include('partials/app-shell-end', { pageScript: '/js/sessions.js' }) %>
