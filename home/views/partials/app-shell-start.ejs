<!DOCTYPE html>
<html lang="en" data-theme="mdlight">
<head>
  <%- include('head') %>
</head>
<body class="min-h-screen">
  <div class="navbar min-h-14 bg-base-100 border-b border-base-300 px-4 lg:px-6">
    <div class="flex-1 gap-2 items-center">
      <a href="<%= homePath %>" class="btn btn-ghost btn-sm gap-2 px-2 text-base font-semibold tracking-tight text-primary">
        <%- include('icon', { name: 'brand', size: 'md' }) %>
        <span>Media Downloader</span>
      </a>
    </div>
    <div class="flex-none">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2">
          <%- include('icon', { name: 'user', size: 'sm' }) %>
          <span><%= account.username %></span>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-56 p-2 border border-base-300 shadow-md">
          <li>
            <a href="<%= changePasswordPath %>" class="gap-2">
              <%- include('icon', { name: 'key', size: 'sm' }) %>
              Change password
            </a>
          </li>
          <li>
            <a href="<%= sessionsPath %>" class="gap-2">
              <%- include('icon', { name: 'devices', size: 'sm' }) %>
              Sessions
            </a>
          </li>
          <li>
            <button
              type="button"
              id="logout-button"
              class="gap-2"
              data-endpoint="<%= logoutEndpoint %>"
              data-redirect="<%= loginPath %>"
            >
              <%- include('icon', { name: 'sign-out', size: 'sm' }) %>
              Sign out
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <main class="p-4 md:p-6">
    <div class="max-w-6xl mx-auto grid gap-5 md:grid-cols-[13rem_1fr]">
      <aside class="md:sticky md:top-6 md:self-start">
        <nav class="flex flex-col gap-1" aria-label="Main">
          <a
            href="<%= homePath %>"
            class="md-nav-link<%= currentPath === homePath ? ' btn-active' : '' %>"
            <% if (currentPath === homePath) { %>aria-current="page"<% } %>
          >
            <%- include('icon', { name: 'house', size: 'sm' }) %>
            Home
          </a>
          <% if (canManageAccounts) { %>
          <a
            href="<%= accountsPath %>"
            class="md-nav-link<%= currentPath === accountsPath ? ' btn-active' : '' %>"
            <% if (currentPath === accountsPath) { %>aria-current="page"<% } %>
          >
            <%- include('icon', { name: 'users', size: 'sm' }) %>
            Accounts
          </a>
          <% } %>
          <a
            href="<%= sessionsPath %>"
            class="md-nav-link<%= currentPath === sessionsPath ? ' btn-active' : '' %>"
            <% if (currentPath === sessionsPath) { %>aria-current="page"<% } %>
          >
            <%- include('icon', { name: 'devices', size: 'sm' }) %>
            Sessions
          </a>
          <a
            href="<%= accessTokensPath %>"
            class="md-nav-link<%= currentPath === accessTokensPath ? ' btn-active' : '' %>"
            <% if (currentPath === accessTokensPath) { %>aria-current="page"<% } %>
          >
            <%- include('icon', { name: 'key', size: 'sm' }) %>
            Access tokens
          </a>
        </nav>
      </aside>
      <div class="min-w-0">
