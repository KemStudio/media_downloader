<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <%- include('head') %>
</head>
<body class="min-h-screen bg-base-200">
  <div class="navbar bg-base-100 shadow-sm px-4">
    <div class="flex-1 gap-2 items-center">
      <a href="<%= homePath %>" class="btn btn-ghost text-xl">Media Downloader</a>
    </div>
    <div class="flex-none">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm"><%= account.username %></div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-52 p-2 shadow">
          <li><a href="<%= changePasswordPath %>">Change password</a></li>
          <li><a href="<%= sessionsPath %>">Sessions</a></li>
          <li>
            <button
              type="button"
              id="logout-button"
              data-endpoint="<%= logoutEndpoint %>"
              data-redirect="<%= loginPath %>"
            >
              Logout
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <main class="p-6">
    <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-[14rem_1fr]">
      <aside class="md:sticky md:top-6 md:self-start">
        <nav class="flex flex-col gap-2" aria-label="Home menu">
          <a
            href="<%= homePath %>"
            class="btn btn-ghost justify-start<%= currentPath === homePath ? ' btn-active' : '' %>"
            <% if (currentPath === homePath) { %>aria-current="page"<% } %>
          >Home</a>
          <% if (canManageAccounts) { %>
          <a
            href="<%= accountsPath %>"
            class="btn btn-ghost justify-start<%= currentPath === accountsPath ? ' btn-active' : '' %>"
            <% if (currentPath === accountsPath) { %>aria-current="page"<% } %>
          >Danh sách tài khoản</a>
          <% } %>
        </nav>
      </aside>
      <div class="min-w-0">
