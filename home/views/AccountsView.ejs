<%- include('partials/app-shell-start') %>

<section
  id="accounts-page"
  data-accounts-endpoint="<%= accountsEndpoint %>"
  data-state-template="<%= accountStateTemplate %>"
  data-role-template="<%= accountRoleTemplate %>"
  data-delete-template="<%= accountByIdTemplate %>"
  data-page-limit="<%= accountsPageLimit %>"
  data-viewer-role="<%= viewerRole %>"
  data-can-delete="<%= canDeleteAccounts ? '1' : '0' %>"
  data-can-change-role="<%= canChangeAccountRole ? '1' : '0' %>"
  data-state-active="<%= accountStates.ACTIVE %>"
  data-state-deactive="<%= accountStates.DEACTIVE %>"
  data-state-hide="<%= accountStates.HIDE %>"
  data-role-user="<%= accountRoles.USER %>"
  data-role-admin="<%= accountRoles.ADMIN %>"
>
  <header class="md-page-header">
    <h1 class="md-page-title">Accounts</h1>
    <p class="md-page-desc">Manage account state for root and admin users.</p>
  </header>

  <fieldset class="mb-5">
    <legend class="text-sm font-medium mb-2">Filter by state</legend>
    <div class="flex flex-wrap gap-4">
      <label class="label cursor-pointer gap-2 justify-start p-0">
        <input
          type="checkbox"
          id="filter-state-active"
          class="checkbox checkbox-sm"
          value="<%= accountStates.ACTIVE %>"
          checked
        />
        <span class="label-text">Active</span>
      </label>
      <label class="label cursor-pointer gap-2 justify-start p-0">
        <input
          type="checkbox"
          id="filter-state-deactive"
          class="checkbox checkbox-sm"
          value="<%= accountStates.DEACTIVE %>"
          checked
        />
        <span class="label-text">Deactive</span>
      </label>
      <label class="label cursor-pointer gap-2 justify-start p-0">
        <input
          type="checkbox"
          id="filter-state-hide"
          class="checkbox checkbox-sm"
          value="<%= accountStates.HIDE %>"
        />
        <span class="label-text">Hide</span>
      </label>
    </div>
  </fieldset>

  <div id="accounts-error" class="alert alert-error text-sm hidden mb-4" role="alert"></div>
  <p id="accounts-status" class="text-sm text-base-content/65 mb-4">Loading accounts…</p>

  <div id="accounts-results" class="mb-5">
    <div id="accounts-table-wrap" class="hidden md:block overflow-x-auto md-surface">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Username</th>
            <th>Role</th>
            <th>State</th>
            <th>Updated</th>
            <th class="w-64">Action</th>
          </tr>
        </thead>
        <tbody id="accounts-table-body"></tbody>
      </table>
    </div>
    <ul id="accounts-list" class="md:hidden flex flex-col gap-3"></ul>
  </div>

  <div class="flex items-center justify-between gap-3">
    <button type="button" id="accounts-prev" class="btn btn-outline btn-sm gap-1.5" disabled>
      <%- include('partials/icon', { name: 'caret-left', size: 'sm' }) %>
      Previous
    </button>
    <span id="accounts-page-info" class="text-sm text-base-content/65"></span>
    <button type="button" id="accounts-next" class="btn btn-outline btn-sm gap-1.5" disabled>
      Next
      <%- include('partials/icon', { name: 'caret-right', size: 'sm' }) %>
    </button>
  </div>
</section>

<%- include('partials/app-shell-end', { pageScript: '/js/accounts.js' }) %>
